# 예시 환경변수. 실제 값(토큰/DB 비밀번호 등)은 커밋하지 말 것 (.env 는 .gitignore 됨).

# ── hub ──
CANGGU_DATABASE_URL=sqlite:///./canggu.db
# CANGGU_DATABASE_URL=postgresql+psycopg://canggu:canggu@localhost:5432/canggu
CANGGU_AGENT_SHARED_TOKEN=dev-token
CANGGU_CORS_ORIGINS=http://localhost:5173

# ── agent ──
CANGGU_CLUSTER_ID=demo
CANGGU_CLUSTER_TOKEN=dev-token
CANGGU_HUB_URL=ws://localhost:8000/agentlink/ws
CANGGU_MOCK=1
# 실 클러스터에서 로컬 kubeconfig 로 개발 시:
# CANGGU_MOCK=0
# CANGGU_USE_LOCAL_KUBECONFIG=1
